<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="omni_base">
  <xacro:property name="deg_to_rad" value="${pi / 180.0}"/>
  <material name="DarkGrey"><color rgba="0.2 0.2 0.2 1"/></material>
  <xacro:include filename="$(find sim_bringup)/urdf/base/base.urdf.xacro"/>
  <xacro:include filename="$(find sim_bringup)/urdf/laser/sick_tim571_laser.urdf.xacro"/>
  <xacro:base name="base"/>
  <xacro:sick_tim571_laser name="base_laser" parent="base_link"
      ros_topic="scan" update_rate="10" min_angle="${-pi}" max_angle="${pi}">
    <origin xyz="0 0 0.28244" rpy="0 0 0"/>
  </xacro:sick_tim571_laser>
</robot>
