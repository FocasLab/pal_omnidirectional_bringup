#!/usr/bin/env python3
import math
from pathlib import Path
from string import Template
from threading import Event

import rclpy
from ament_index_python.packages import get_package_share_directory
from gazebo_msgs.srv import DeleteEntity, SpawnEntity
from rclpy.callback_groups import ReentrantCallbackGroup
from rclpy.executors import ExternalShutdownException, MultiThreadedExecutor
from rclpy.node import Node
from rclpy.qos import DurabilityPolicy, QoSProfile
from sim_bringup.msg import Obstacle
from sim_bringup.srv import SetObstacle


class ObstacleServer(Node):
    HEIGHT = 1.0

    def __init__(self):
        super().__init__('obstacle_server')
        package = Path(get_package_share_directory('sim_bringup'))
        self.template = Template((package / 'models/cylinder/model.sdf.in').read_text())
        group = ReentrantCallbackGroup()
        self.spawn = self.create_client(SpawnEntity, '/spawn_entity', callback_group=group)
        self.delete = self.create_client(DeleteEntity, '/delete_entity', callback_group=group)
        self.publisher = self.create_publisher(
            Obstacle, '/obstacle',
            QoSProfile(depth=1, durability=DurabilityPolicy.TRANSIENT_LOCAL),
        )
        self.obstacle = None
        self.entity = None
        self.sequence = 0
        self.create_service(SetObstacle, '/set_obstacle', self.set_obstacle)
        self.create_timer(1.0, self.publish_obstacle)

    def call(self, client, request):
        if not client.wait_for_service(timeout_sec=5.0):
            raise RuntimeError(f'{client.srv_name} is unavailable')
        future = client.call_async(request)
        ready = Event()
        future.add_done_callback(lambda _: ready.set())
        if not ready.wait(15.0):
            raise RuntimeError(f'{client.srv_name} timed out; simulation state is uncertain')
        result = future.result()
        if not result.success:
            raise RuntimeError(result.status_message)
        return result

    def spawn_cylinder(self, obstacle):
        request = SpawnEntity.Request()
        self.sequence += 1
        request.name = f'obstacle_{self.sequence}'
        request.xml = self.template.substitute(radius=obstacle.radius, height=self.HEIGHT)
        request.reference_frame = 'world'
        request.initial_pose.position = obstacle.center
        request.initial_pose.orientation.w = 1.0
        self.call(self.spawn, request)
        self.entity = request.name

    def set_obstacle(self, request, response):
        if not all(map(math.isfinite, (request.x, request.y, request.radius))) or request.radius <= 0:
            response.message = 'Coordinates must be finite and radius must be positive.'
            return response

        obstacle = Obstacle()
        obstacle.header.frame_id = 'world'
        obstacle.center.x = request.x
        obstacle.center.y = request.y
        obstacle.center.z = self.HEIGHT / 2.0
        obstacle.radius = request.radius
        previous = self.obstacle
        deleted = False
        try:
            if previous is not None:
                self.call(self.delete, DeleteEntity.Request(name=self.entity))
                deleted = True
            self.spawn_cylinder(obstacle)
        except RuntimeError as error:
            response.message = str(error)
            if deleted:
                try:
                    self.spawn_cylinder(previous)
                except RuntimeError as restore_error:
                    self.obstacle = None
                    response.message += f'; restore failed: {restore_error}. Restart the world.'
            self.get_logger().error(response.message)
            return response

        self.obstacle = obstacle
        self.publish_obstacle()
        response.success = True
        response.message = f'Obstacle: x={request.x:g}, y={request.y:g}, radius={request.radius:g} m'
        return response

    def publish_obstacle(self):
        if self.obstacle is not None:
            self.obstacle.header.stamp = self.get_clock().now().to_msg()
            self.publisher.publish(self.obstacle)


def main():
    rclpy.init()
    node = ObstacleServer()
    executor = MultiThreadedExecutor(num_threads=2)
    executor.add_node(node)
    try:
        executor.spin()
    except (KeyboardInterrupt, ExternalShutdownException):
        pass
    finally:
        executor.shutdown()
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == '__main__':
    main()
